new file mode 100644
index 0000000..0d766d2
--- /dev/null
+++ b/utils/embeds.py
@@ -0,0 +1,64 @@
+"""
+Shared embed styling for Bread Bot.
+
+Every embed the bot sends should pull its color from the palette below and
+go through make_embed() so titles, footers, and timestamps stay consistent
+no matter which cog is sending it. Don't hardcode hex colors at call sites.
+"""
+import discord
+
+# ===== Color palette =====
+# Semantic, not per-command - pick based on what the embed communicates,
+# not which command happens to send it.
+COLOR_SUCCESS = 0x57F287   # positive/completed outcomes: unban, config saved, filter on
+COLOR_ERROR = 0xED4245     # bans, blocked actions, filtered messages, failures
+COLOR_WARNING = 0xF5A623   # mutes, warnings, purges, disabled states, kicks
+COLOR_INFO = 0x5865F2      # lookups: userinfo, serverinfo, botinfo, help, apod
+COLOR_NEUTRAL = 0x99AAB5   # low-stakes notices, "nothing to show" states
+COLOR_BRAND = 0xE8A33D     # bot-identity moments: welcome messages, fun/misc
+
+FOOTER_TEXT = "Bread Bot"
+
+
+def make_embed(
+    *,
+    title=None,
+    description=None,
+    color=COLOR_INFO,
+    fields=None,
+    thumbnail=None,
+    image=None,
+    url=None,
+    author=None,
+    author_icon=None,
+    icon=None,
+    footer=None,
+    timestamp=True,
+):
+    """Build a Discord embed with the bot's standard look.
+
+    fields: list of (name, value, inline) tuples.
+    icon: url to use as the footer icon (usually guild.me.display_avatar.url
+        or bot.user.display_avatar.url) - keeps the footer branded without
+        every call site having to build that string itself.
+    Always stamps a timestamp and a consistent footer unless overridden.
+    """
+    embed = discord.Embed(title=title, description=description, color=color, url=url)
+
+    if timestamp:
+        embed.timestamp = discord.utils.utcnow()
+
+    for field in fields or []:
+        name, value, inline = field
+        embed.add_field(name=name, value=value, inline=inline)
+
+    if thumbnail:
+        embed.set_thumbnail(url=thumbnail)
+    if image:
+        embed.set_image(url=image)
+    if author:
+        embed.set_author(name=author, icon_url=author_icon)
+
+    embed.set_footer(text=footer or FOOTER_TEXT, icon_url=icon)
+
+    return embed
