+from utils.embeds import make_embed, COLOR_WARNING, COLOR_ERROR, COLOR_SUCCESS, COLOR_NEUTRAL, COLOR_BRAND
 from utils.database import warnings_collection, moderation_cases_collection, filter_collection
 
 
+def _build_warnings_embed(guild, member, warnings):
+    """Shared embed builder for the /warnings display - used both on first
+    send and every time the button/select UI refreshes the message."""
+    embed = make_embed(
+        title=f"⚠️ Warnings for {member}",
+        description=f"Total warnings: {len(warnings)}" if warnings else "This member has no warnings.",
+        color=COLOR_WARNING if warnings else COLOR_SUCCESS,
+        thumbnail=member.display_avatar.url,
+        icon=guild.me.display_avatar.url if guild.me else None,
+    )
+
+    for warning in warnings:
+        moderator = guild.get_member(warning.get("moderator_id"))
+        moderator_name = moderator.mention if moderator else f"<@{warning.get('moderator_id')}>"
+        reason = warning.get("reason", "No reason provided")
+        evidence = warning.get("evidence", "")
+        warning_num = warning.get("warning_number", 0)
+        created_at = warning.get("created_at")
+        created_str = discord.utils.format_dt(created_at, "R") if created_at else "Unknown"
+
+        embed.add_field(
+            name=f"Warning #{warning_num}",
+            value=f"**Reason:** {reason}\n**Moderator:** {moderator_name}\n**Evidence:** {evidence if evidence else 'None'}\n**Date:** {created_str}",
+            inline=False,
+        )
+
+    return embed
+
+
+class _WarningsPermissionMixin:
+    """Shared permission gate + timeout handling for the warnings management views."""
+
+    async def interaction_check(self, interaction: discord.Interaction) -> bool:
+        if not interaction.user.guild_permissions.moderate_members:
+            await interaction.response.send_message(
+                "❌ You need Moderate Members permission to manage warnings.", ephemeral=True
+            )
+            return False
+        return True
+
+    async def on_timeout(self):
+        for item in self.children:
+            item.disabled = True
+        if self.message:
+            try:
+                await self.message.edit(view=self)
+            except discord.HTTPException:
+                pass
+
+
+class WarningDeleteSelect(discord.ui.Select):
+    """Dropdown listing each warning so a moderator can delete a specific one."""
+
+    def __init__(self, warnings):
+        options = [
+            discord.SelectOption(
+                label=f"Delete Warning #{w.get('warning_number')}",
+                description=(w.get("reason") or "No reason provided")[:100],
+                value=str(w.get("warning_number")),
+                emoji="🗑️",
+            )
+            for w in warnings[:25]  # Discord caps select menus at 25 options
+        ]
+        super().__init__(
+            placeholder="Delete a specific warning...",
+            options=options,
+            min_values=1,
+            max_values=1,
+            row=0,
+        )
+
+    async def callback(self, interaction: discord.Interaction):
+        view: WarningsView = self.view
+        warning_number = int(self.values[0])
+
+        deleted = await delete_warning(view.guild.id, view.member.id, warning_number)
+        warnings = await get_member_warnings(view.guild.id, view.member.id)
+
+        embed = _build_warnings_embed(view.guild, view.member, warnings)
+        if deleted:
+            note = f"🗑️ Warning #{warning_number} deleted. Remaining warnings have been renumbered."
+            embed.description = f"{note}\n{embed.description}" if embed.description else note
+
+        new_view = WarningsView(view.guild, view.member, warnings) if warnings else None
+        await interaction.response.edit_message(embed=embed, view=new_view)
+        if new_view:
+            new_view.message = interaction.message
+
+
+class ClearAllButton(discord.ui.Button):
+    """Kicks off the clear-all flow - swaps to a confirm/cancel view rather than
+    deleting immediately, since this is a destructive, unrecoverable action."""
+
+    def __init__(self, disabled=False):
+        super().__init__(
+            label="Clear All Warnings", style=discord.ButtonStyle.danger, emoji="🧹", row=1, disabled=disabled
+        )
+
+    async def callback(self, interaction: discord.Interaction):
+        view: WarningsView = self.view
+        confirm_view = ConfirmClearView(view.guild, view.member, view.warnings)
+        embed = make_embed(
+            title=f"⚠️ Clear all warnings for {view.member}?",
+            description=(
+                f"This permanently deletes all **{len(view.warnings)}** warning(s) for "
+                f"{view.member.mention}. This can't be undone."
+            ),
+            color=COLOR_ERROR,
+            icon=view.guild.me.display_avatar.url if view.guild.me else None,
+        )
+        await interaction.response.edit_message(embed=embed, view=confirm_view)
+        confirm_view.message = interaction.message
+
+
+class WarningsView(_WarningsPermissionMixin, discord.ui.View):
+    """Main /warnings view: a delete-select for individual warnings plus a
+    clear-all button. Only moderators (Moderate Members permission) can use it."""
+
+    def __init__(self, guild, member, warnings, *, timeout=180):
+        super().__init__(timeout=timeout)
+        self.guild = guild
+        self.member = member
+        self.warnings = warnings
+        self.message = None
+        if warnings:
+            self.add_item(WarningDeleteSelect(warnings))
+        self.add_item(ClearAllButton(disabled=not warnings))
+
+
+class ConfirmClearView(_WarningsPermissionMixin, discord.ui.View):
+    """Second step of the clear-all flow: an explicit confirm before wiping
+    every warning for a member."""
+
+    def __init__(self, guild, member, warnings, *, timeout=60):
+        super().__init__(timeout=timeout)
+        self.guild = guild
+        self.member = member
+        self.warnings = warnings
+        self.message = None
+
+    @discord.ui.button(label="Confirm", style=discord.ButtonStyle.danger, emoji="✅")
+    async def confirm(self, interaction: discord.Interaction, button: discord.ui.Button):
+        count = await clear_warnings(self.guild.id, self.member.id)
+        embed = make_embed(
+            title=f"⚠️ Warnings for {self.member}",
+            description=f"🧹 Cleared {count} warning(s). {self.member.mention} now has no warnings.",
+            color=COLOR_SUCCESS,
+            thumbnail=self.member.display_avatar.url,
+            icon=self.guild.me.display_avatar.url if self.guild.me else None,
+        )
+        await interaction.response.edit_message(embed=embed, view=None)
+
+    @discord.ui.button(label="Cancel", style=discord.ButtonStyle.secondary, emoji="↩️")
+    async def cancel(self, interaction: discord.Interaction, button: discord.ui.Button):
+        embed = _build_warnings_embed(self.guild, self.member, self.warnings)
+        new_view = WarningsView(self.guild, self.member, self.warnings)
+        await interaction.response.edit_message(embed=embed, view=new_view)
+        new_view.message = interaction.message
+
+
+class FormattedMessageModal(discord.ui.Modal, title="Compose Formatted Message"):
+    """Popup form for /sendmessage - fills in title/body/color/image/footer,
+    then posts a formatted embed to the chosen channel on submit."""
+
+    msg_title = discord.ui.TextInput(
+        label="Title",
+        placeholder="Announcement title",
+        max_length=256,
+        required=True,
+    )
+    body = discord.ui.TextInput(
+        label="Message",
+        style=discord.TextStyle.paragraph,
+        placeholder="The message body...",
+        max_length=4000,
+        required=True,
+    )
+    color_hex = discord.ui.TextInput(
+        label="Color (hex, optional)",
+        placeholder="e.g. e8a33d - leave blank for the default bread gold",
+        required=False,
+        max_length=7,
+    )
+    image_url = discord.ui.TextInput(
+        label="Image URL (optional)",
+        placeholder="https://...",
+        required=False,
+    )
+    footer_text = discord.ui.TextInput(
+        label="Footer text (optional)",
+        placeholder="Leave blank for the default footer",
+        required=False,
+        max_length=100,
+    )
+
+    def __init__(self, channel: discord.TextChannel, ping_everyone: bool):
+        super().__init__()
+        self.channel = channel
+        self.ping_everyone = ping_everyone
+
+    async def on_submit(self, interaction: discord.Interaction):
+        color = COLOR_BRAND
+        invalid_color = False
+        raw_color = (self.color_hex.value or "").strip().lstrip("#")
+        if raw_color:
+            try:
+                color = int(raw_color, 16)
+            except ValueError:
+                invalid_color = True
+
+        embed = make_embed(
+            title=str(self.msg_title),
+            description=str(self.body),
+            color=color,
+            image=self.image_url.value.strip() if self.image_url.value else None,
+            footer=self.footer_text.value.strip() if self.footer_text.value else None,
+            icon=interaction.guild.me.display_avatar.url if interaction.guild.me else None,
+        )
+
+        content = "@everyone" if self.ping_everyone else None
+
+        try:
+            sent = await self.channel.send(content=content, embed=embed)
+        except discord.Forbidden:
+            await interaction.response.send_message(
+                f"❌ I don't have permission to send messages in {self.channel.mention}.", ephemeral=True
+            )
+            return
+        except Exception as e:
+            await interaction.response.send_message(f"❌ Failed to send: {e}", ephemeral=True)
+            return
+
+        confirmation = f"✅ Sent to {self.channel.mention}. [Jump to message]({sent.jump_url})"
+        if invalid_color:
+            confirmation += f"\n⚠️ '{raw_color}' wasn't a valid hex color, used the default instead."
+        await interaction.response.send_message(confirmation, ephemeral=True)
+
+    async def on_error(self, interaction: discord.Interaction, error: Exception):
+        print(f"[ERROR] FormattedMessageModal: {error}")
+        if not interaction.response.is_done():
+            await interaction.response.send_message(
+                "❌ Something went wrong sending that message.", ephemeral=True
+            )
+
