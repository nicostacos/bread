-        """Get NASA's Astronomy Picture of the Day"""
-        await interaction.response.send_message("✅ NASA APOD command works!", ephemeral=True)
+    @app_commands.describe(date="Optional date in YYYY-MM-DD format")
+    async def apod(self, interaction: discord.Interaction, date: str = None):
+        """Get NASA's Astronomy Picture of the Day (slash command)"""
+        await interaction.response.defer()
+        try:
+            data = await fetch_apod(self.bot, date)
+            embed = build_apod_embed(data)
+            await interaction.followup.send(embed=embed)
+        except RuntimeError as e:
+            await interaction.followup.send(f"❌ {e}", ephemeral=True)
+
+    @commands.command(name="apod")
+    async def apod_prefix(self, ctx, date: str = None):
+        """Get NASA's Astronomy Picture of the Day (prefix command)"""
+        async with ctx.typing():
+            try:
+                data = await fetch_apod(self.bot, date)
+                embed = build_apod_embed(data)
+                await ctx.send(embed=embed)
+            except RuntimeError as e:
+                await ctx.send(f"❌ {e}")
 
 
