index e2b3731..4c7668f 100644
--- a/cogs/nasa.py
+++ b/cogs/nasa.py
@@ -6,18 +6,107 @@ from discord import app_commands
 from discord.ext import commands
 import aiohttp
 
+from config import NASA_API_KEY
+from utils.embeds import make_embed, COLOR_INFO
+
+APOD_URL = "https://api.nasa.gov/planetary/apod"
+
+
+async def fetch_apod(bot: commands.Bot, date: str = None) -> dict:
+    """Hit the NASA APOD endpoint and return the parsed JSON.
+    Raises RuntimeError with a user-facing message on failure."""
+    params = {"api_key": NASA_API_KEY}
+    if date:
+        params["date"] = date
+
+    # Prefer the bot's shared session if it's up, otherwise open a throwaway one
+    session = getattr(bot, "aiohttp_session", None)
+    if session is None or session.closed:
+        async with aiohttp.ClientSession() as temp_session:
+            return await _do_fetch(temp_session, params)
+    return await _do_fetch(session, params)
+
+
+async def _do_fetch(session: aiohttp.ClientSession, params: dict) -> dict:
+    try:
+        async with session.get(APOD_URL, params=params, timeout=aiohttp.ClientTimeout(total=10)) as resp:
+            if resp.status == 429:
+                raise RuntimeError("NASA's API is rate-limiting us right now. Try again in a bit.")
+            if resp.status != 200:
+                body = await resp.text()
+                raise RuntimeError(f"NASA API returned status {resp.status}: {body[:200]}")
+            return await resp.json()
+    except aiohttp.ClientError as e:
+        raise RuntimeError(f"Couldn't reach the NASA API: {e}")
+    except Exception as e:
+        if isinstance(e, RuntimeError):
+            raise
+        raise RuntimeError(f"Unexpected error calling NASA API: {e}")
+
+
+def build_apod_embed(data: dict) -> discord.Embed:
+    """Build a Discord embed from a NASA APOD API response."""
+    fields = []
+    if data.get("date"):
+        fields.append(("Date", data["date"], True))
+    if data.get("copyright"):
+        fields.append(("Copyright", data["copyright"].strip(), True))
+
+    media_type = data.get("media_type")
+    video_field = None
+    if media_type == "video":
+        video_field = ("Video", f"[Watch here]({data.get('url')})", False)
+
+    embed = make_embed(
+        title=data.get("title", "NASA Astronomy Picture of the Day"),
+        description=(data.get("explanation") or "")[:4096],
+        color=COLOR_INFO,
+        fields=fields,
+        url="https://apod.nasa.gov/apod/astropix.html",
+        footer="NASA Astronomy Picture of the Day",
+    )
+
+    if media_type == "image":
+        image_url = data.get("hdurl") or data.get("url")
+        if image_url:
+            embed.set_image(url=image_url)
+    elif media_type == "video":
+        embed.add_field(name=video_field[0], value=video_field[1], inline=video_field[2])
+        thumb = data.get("thumbnail_url")
+        if thumb:
+            embed.set_thumbnail(url=thumb)
+
+    return embed
+
 
