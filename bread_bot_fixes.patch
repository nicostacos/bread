+async def delete_warning(guild_id, user_id, warning_number):
+    """Delete a single warning by its current (position-based) number.
+    Numbers are recomputed from position every call, so deleting one
+    automatically renumbers whatever's left - no separate renumber step needed.
+    Returns True if something was deleted, False if that number didn't exist."""
+    warnings = await get_member_warnings(guild_id, user_id)
+    target = next((w for w in warnings if w.get("warning_number") == warning_number), None)
+    if not target:
+        return False
+    result = await warnings_collection.delete_one({"_id": target["_id"]})
+    return result.deleted_count > 0
+
+
+async def clear_warnings(guild_id, user_id):
+    """Delete every warning for a member. Returns the number deleted."""
+    result = await warnings_collection.delete_many({"guild_id": guild_id, "user_id": user_id})
+    return result.deleted_count
+
